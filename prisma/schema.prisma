generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String    @default("Admin")
  passwordHash             String
  mustChangePassword       Boolean   @default(true)
  isAdmin                  Boolean   @default(false)
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  emailVerifiedAt          DateTime?
  phone                    String?
  phoneVerifiedAt          DateTime?
  subscribeConfirmationToken String? @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model EmailListSubscriber {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  email             String    @unique
  emailVerifiedAt   DateTime?
  phone             String?
  phoneVerifiedAt   DateTime?
  confirmationToken String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Issues for /magazines — files live under public/magazines/ and public/magazines/cover-thumbnails/
model Magazine {
  id           String   @id @default(cuid())
  slug         String   @unique
  displayTitle String
  releaseDate  DateTime
  releaseLabel String
  blurb        String   @db.Text
  coverSrc     String
  /// Legacy PDF reader at /magazines/read/[slug]; optional when flipbookUrl is set
  pdfSrc       String   @default("")
  /// FlipHTML5 / branded digital edition URL for modal + reader iframe
  flipbookUrl  String   @default("")
  purchaseUrl  String?  @db.Text
  subscribeUrl String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([releaseDate])
}

// Admin-editable JSON for /visit/[slug]; overrides bundled defaults when present.
model StateDestinationContent {
  slug      String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

/// National list + state “Eat” picks; nationalRank 1–1000 for Top Restaurants page (null = not on national list).
model Restaurant {
  id            String   @id @default(cuid())
  name          String
  address       String   @default("")
  phone         String   @default("")
  website       String   @default("")
  openTableUrl  String   @default("")
  cuisine       String   @default("")
  /// Display + filters (county & city pages).
  city          String   @default("")
  county        String   @default("")
  /// URL segments for /top-restaurants/[state]/[county]/[city]/[nameSlug]
  citySlug      String   @default("unknown")
  countySlug    String   @default("unknown")
  nameSlug      String   @default("")
  owner         String   @default("")
  headChef      String   @default("")
  awards        String   @default("—")
  thumbnailUrl  String   @default("") @db.Text
  stateSlug     String   @default("")
  country       String   @default("United States")
  nationalRank  Int?     @unique
  /// Top Restaurants — Europe list (1–500); mutually exclusive with nationalRank for ranked rows.
  europeRank    Int?     @unique
  /// Top Restaurants — Italy list (1–78); routes `/top-restaurants/italy/[city]/[slug]`.
  italyRank     Int?     @unique
  highlights    StateRestaurantHighlight[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([stateSlug, countySlug, citySlug, nameSlug])
  @@index([stateSlug])
  @@index([country])
  @@index([cuisine])
  @@index([citySlug])
  @@index([countySlug])
  @@index([nameSlug])
}

/// Up to 8 restaurants featured on /visit/[stateSlug] — order by position.
model StateRestaurantHighlight {
  id           String     @id @default(cuid())
  stateSlug    String
  restaurantId String
  position     Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([stateSlug, position])
  @@unique([stateSlug, restaurantId])
  @@index([stateSlug])
}

/// Top Chefs profiles — /top-chefs and /top-chefs/[slug]; editable in admin.
model Chef {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  imageUrl    String   @db.Text
  cuisines    Json
  sortOrder   Int      @default(0)
  birthDate          DateTime?
  birthPlace         String   @default("")
  specialtyCuisine   String   @default("")
  awards             String   @default("") @db.Text
  ownedRestaurants   Json     @default("[]")
  /// Optional Restaurant row IDs (cuid) to show under "national list" on the chef profile; overrides name matching when non-empty.
  pinnedRankedRestaurantIds Json @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([name])
}

/// Site-wide ad banner rotator — images in public/banners/ (or Vercel Blob); editable in admin.
model AdBanner {
  id        String   @id @default(cuid())
  imageSrc  String   @db.Text
  href      String   @db.Text
  label     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
